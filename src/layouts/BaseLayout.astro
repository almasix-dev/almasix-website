---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Almasix',
	description = 'Laravel’s application shape, in async Python — the elegant web framework with Articulate, Prism, and the Smith CLI.',
} = Astro.props;

const pageTitle = title === 'Almasix' ? title : `${title} · Almasix`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#F1511B" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="wrap site-header">
			<a class="brand" href="/" aria-label="Almasix home">
				<img src="/almasix-banner-light.svg" alt="Almasix" width="160" height="36" />
			</a>
			<nav class="nav" aria-label="Primary">
				<a href="https://docs.almasix.com/">Docs</a>
				<a href="https://github.com/almasix-dev/almasix">GitHub</a>
				<a href="https://pypi.org/project/almasix/">PyPI</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<div class="wrap">
				<p>© {new Date().getFullYear()} Almasix. MIT License.</p>
				<nav aria-label="Footer">
					<a href="https://docs.almasix.com/">Documentation</a>
					<a href="https://github.com/almasix-dev">GitHub org</a>
					<a href="https://github.com/sponsors/coolsam726">Sponsor</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
